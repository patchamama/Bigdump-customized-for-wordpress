# Backup files — never commit database dumps
backups/*.sql
backups/*.gz
backups/*.zip

# Dump files in root (imported/exported)
*.sql
*.gz
*.zip

# BigDump config — contains FTP credentials and URLs
bigdump.config.json

# WordPress config — contains DB credentials
wp-config.php
wp-config_.php

# Migration tool runtime state — contains the auth hash
.migrate_config
.migrate_exports/
.migrate_snapshots/
_phpcfg_test_*/
_perma_test_*/
_sitepass_test_*/

# Tooling / OS cruft
.DS_Store
.atl/

# Temporary files
*.tmp
_autorec_test_*/
_ht_test_*/
_orphans-remove-it/
_junk-remove-it/
wp-content/_orphans-remove-it/
_perf_test_*/
_ht_diag_*/
